generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  ADMIN
  WORKER
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  email                String    @unique
  phone                String?   @unique
  passwordHash         String
  fullName             String
  role                 UserRole  @default(OWNER)
  isActive             Boolean   @default(true)
  emailVerified        Boolean   @default(false)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  farms                Farm[]
  refreshTokens        RefreshToken[]
  gardenAssignments    UserGardenAssignment[]
  
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
}

model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  token       String    @unique
  deviceInfo  String?   // để biết đăng nhập từ thiết bị nào (hữu ích cho app mobile/PWA)
  expiresAt   DateTime
  revoked     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Farm {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String
  location  String
  totalArea Float

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user        User        @relation(fields: [userId], references: [id])
  gardens     Garden[]
  inventories Inventory[]
  inventoryTransactions InventoryTransaction[]
  otherExpenses         OtherExpense[]
}

model Garden {
  id            String    @id @default(uuid()) @db.Uuid
  farmId        String    @db.Uuid
  name          String
  area          Float

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  farm          Farm      @relation(fields: [farmId], references: [id])
  treeBatches   TreeBatch[]
  assignments   UserGardenAssignment[]
}

model UserGardenAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  gardenId      String    @db.Uuid

  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  garden        Garden    @relation(fields: [gardenId], references: [id])

  @@unique([userId, gardenId])
}

model CropType {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  type          String

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  treeBatches   TreeBatch[]
  growthCycles  GrowthCycle[]
}

model GrowthCycle {
  id          String   @id @default(uuid()) @db.Uuid
  cropTypeId  String   @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  cropType      CropType      @relation(fields: [cropTypeId], references: [id])
  stages        GrowthStage[]
  treeBatches   TreeBatch[]
}

model GrowthStage {
  id            String   @id @default(uuid()) @db.Uuid
  growthCycleId String   @db.Uuid
  name          String
  sequence      Int
  durationDays  Int
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  growthCycle GrowthCycle @relation(fields: [growthCycleId], references: [id])

  @@unique([growthCycleId, sequence])
}

model TreeBatch {
  id                String    @id @default(uuid()) @db.Uuid
  gardenId          String    @db.Uuid
  cropTypeId        String    @db.Uuid
  growthCycleId     String?   @db.Uuid
  name              String
  startDate         DateTime
  expectedEndDate   DateTime
  actualEndDate     DateTime?
  status            String
  totalYield        Float?    // Tổng sản lượng thu hoạch được của vụ này

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  garden            Garden       @relation(fields: [gardenId], references: [id])
  cropType          CropType     @relation(fields: [cropTypeId], references: [id])
  growthCycle       GrowthCycle? @relation(fields: [growthCycleId], references: [id])
  activityLogs      ActivityLog[]
}

model Material {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  unit          String
  defaultPrice  Float

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  inventories       Inventory[]
  activityMaterials ActivityMaterial[]
  inventoryTransactions InventoryTransaction[]
}

model Inventory {
  id                String    @id @default(uuid()) @db.Uuid
  farmId            String    @db.Uuid
  materialId        String    @db.Uuid
  quantity          Float     @default(0)
  totalCost         Float     @default(0)
  averageUnitPrice  Float     @default(0) // Dùng để xuất kho tính giá vốn trung bình
  lowStockThreshold Float     @default(10)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  farm              Farm      @relation(fields: [farmId], references: [id])
  material          Material  @relation(fields: [materialId], references: [id])

  @@unique([farmId, materialId]) // Một farm chỉ có 1 dòng inventory cho 1 loại vật tư
}

model ActivityLog {
  id              String    @id @default(uuid()) @db.Uuid
  treeBatchId     String    @db.Uuid
  activityType    String    // VD: LAM_DAT, TUOI, BON_PHAN, PHUN_THUOC, THU_HOACH...
  activityDate    DateTime
  notes           String?
  syncStatus      String    // VD: PENDING, SYNCED, CONFLICT

  // Dành cho loại hình công việc có tính phí (nhân công / thuê máy móc)
  cost            Float?
  
  // Dành riêng cho loại hình THU_HOACH
  harvestQuantity Float?    // Sản lượng thu được trong lần thu hoạch này
  revenue         Float?    // Doanh thu ước tính/thực tế của đợt thu hoạch

  photos          String[]  @default([]) // Thêm mảng lưu trữ URL ảnh đính kèm

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt     DateTime?

  treeBatch       TreeBatch          @relation(fields: [treeBatchId], references: [id])
  materials       ActivityMaterial[]
  inventoryTransactions InventoryTransaction[]
}

// Bảng trung gian để 1 hoạt động có thể dùng nhiều loại vật tư (VD: pha 2 loại phân bón)
model ActivityMaterial {
  id              String    @id @default(uuid()) @db.Uuid
  activityLogId   String    @db.Uuid
  materialId      String    @db.Uuid
  quantityUsed    Float
  cost            Float     // Chi phí vật tư (quantityUsed * đơn giá)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt     DateTime?

  activityLog     ActivityLog @relation(fields: [activityLogId], references: [id])
  material        Material    @relation(fields: [materialId], references: [id])
}

model InventoryTransaction {
  id            String    @id @default(uuid()) @db.Uuid
  farmId        String    @db.Uuid
  materialId    String    @db.Uuid
  type          String    // IMPORT, EXPORT
  quantity      Float
  unitPrice     Float
  totalCost     Float
  notes         String?
  
  activityLogId String?   @db.Uuid 

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  farm          Farm      @relation(fields: [farmId], references: [id])
  material      Material  @relation(fields: [materialId], references: [id])
  activityLog   ActivityLog? @relation(fields: [activityLogId], references: [id])
}

model OtherExpense {
  id            String    @id @default(uuid()) @db.Uuid
  farmId        String    @db.Uuid
  expenseDate   DateTime
  category      String    // MACHINE_RENTAL, TRANSPORT, OTHER...
  amount        Float
  notes         String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  farm          Farm      @relation(fields: [farmId], references: [id])
}
